{
  "hosting": {
    "public": "build",
		"redirects": [
      {
        "source": "/",
        "destination": "https://ksushi.menu/",
        "type": 301
      }
		],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
